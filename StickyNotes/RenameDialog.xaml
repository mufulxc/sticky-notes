<Window x:Class="StickyNotes.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名文件夹"
        Width="320" Height="140"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Background="#1E1F35" Margin="0">
        <StackPanel Margin="20,16">
            <TextBlock Text="输入新名称" Foreground="#E8E8F0" FontSize="12" Margin="0,0,0,10"/>
            <TextBox x:Name="NameBox"
                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14" Padding="6,4"
                     Background="#2A2B45" Foreground="#E8E8F0"
                     BorderBrush="#7C5CFC" BorderThickness="1"
                     CaretBrush="#7C5CFC"
                     KeyDown="NameBox_KeyDown"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" Width="70" Height="28"
                        Background="#3A3B60" Foreground="#E8E8F0"
                        BorderThickness="0" Cursor="Hand"
                        Click="Cancel_Click"/>
                <Button Content="确定" Width="70" Height="28" Margin="8,0,0,0"
                        Background="#7C5CFC" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
