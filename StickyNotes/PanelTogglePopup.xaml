<Popup x:Class="StickyNotes.PanelTogglePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        PopupAnimation="Fade"
        StaysOpen="True"
        LostMouseCapture="Popup_LostMouseCapture">

    <Border Background="#2A2B45"
            BorderBrush="#7C5CFC"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8,6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="面板显示" Foreground="#8888A0" FontSize="10"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <!-- 左侧 -->
                <Button x:Name="BtnLeft" Width="44" Height="36" Margin="2"
                        Click="BtnLeft_Click" Cursor="Hand" ToolTip="左">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#2A2B45"
                                    BorderBrush="#4A4B70" BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock Text="◀" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#8888A0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#7C5CFC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- 中间 -->
                <Button x:Name="BtnCenter" Width="44" Height="36" Margin="2"
                        Click="BtnCenter_Click" Cursor="Hand" ToolTip="中">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#2A2B45"
                                    BorderBrush="#4A4B70" BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock Text="■" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#8888A0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#7C5CFC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- 右侧 -->
                <Button x:Name="BtnRight" Width="44" Height="36" Margin="2"
                        Click="BtnRight_Click" Cursor="Hand" ToolTip="右">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#2A2B45"
                                    BorderBrush="#4A4B70" BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock Text="▶" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#8888A0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#7C5CFC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Popup>
