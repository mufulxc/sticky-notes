<Popup x:Class="StickyNotes.FolderDeletePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        PopupAnimation="Fade"
        StaysOpen="True">

    <Border Background="#2A2B45"
            BorderBrush="#7C5CFC"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,8"
            MinWidth="180">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="删除文件夹" Foreground="#8888A0" FontSize="10"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <ItemsControl x:Name="FolderList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,1" Padding="8,3"
                                Background="Transparent" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" Foreground="#E8E8F0"
                                           FontSize="12" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="✕" Width="26" Height="22"
                                        Background="Transparent"
                                        Foreground="#FF6B6B"
                                        BorderThickness="0" FontSize="11"
                                        Cursor="Hand"
                                        Click="BtnDelete_Click"
                                        Tag="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#4A2020"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Popup>
