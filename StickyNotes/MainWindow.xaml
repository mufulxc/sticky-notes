<Window x:Class="StickyNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:StickyNotes.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="随手贴"
        Width="900" Height="550"
        MinWidth="500" MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Topmost="True"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="22"
                      ResizeBorderThickness="5"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:StringEqualityConverter x:Key="StringEqualityConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{StaticResource TabInactive}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333460"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 主容器 -->
    <Border Background="{StaticResource BgDark}"
            CornerRadius="12"
            BorderBrush="#3A3B60"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ 标题栏 ═══ -->
            <Border Grid.Row="0" Background="{StaticResource BgTitleBar}"
                    CornerRadius="12,12,0,0" Height="22"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="随手贴"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="10" FontWeight="SemiBold"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                        <Button Content="─" Width="28" Height="18"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Background="Transparent"
                                Foreground="{StaticResource TextSecondary}"
                                BorderThickness="0" FontSize="9"
                                Click="BtnMinimize_Click" Cursor="Hand"/>
                        <Button Content="_" Width="28" Height="18"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Background="Transparent"
                                Foreground="{StaticResource TextSecondary}"
                                BorderThickness="0" FontSize="9"
                                Click="BtnHide_Click" Cursor="Hand"/>
                        <Button Content="✕" Width="28" Height="18"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Background="Transparent"
                                Foreground="{StaticResource TextSecondary}"
                                BorderThickness="0" FontSize="9"
                                Click="BtnClose_Click" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 标签页 ═══ -->
            <Border Grid.Row="1" Background="{StaticResource BgDark}">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="10,2,0,0">
                        <ItemsControl ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}"
                                            MouseRightButtonDown="Tab_Rename"
                                            MouseDoubleClick="Tab_PanelToggle"
                                            Command="{Binding DataContext.SwitchFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TabBtn}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource StringEqualityConverter}">
                                                                <Binding Path="Name"/>
                                                                <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.SelectedFolder.Name"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{StaticResource TabActive}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentPurple}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="+" Width="24" Height="24" Margin="6,3,0,0"
                                Background="Transparent"
                                Foreground="{StaticResource AccentPurple}"
                                BorderThickness="0" FontSize="16"
                                Cursor="Hand" ToolTip="新增文件夹"
                                Click="BtnAddFolder_Click"/>
                        <Button Content="−" Width="24" Height="24" Margin="0,3,0,0"
                                Background="Transparent"
                                Foreground="#FF6B6B"
                                BorderThickness="0" FontSize="16"
                                Cursor="Hand" ToolTip="删除文件夹"
                                Click="BtnDelFolder_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 三栏编辑区（索引数组驱动，复用同一套绑定） ═══ -->
            <Grid x:Name="ContentGrid" Grid.Row="2" Margin="6,0,6,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColLeft"   Width="*"/>
                    <ColumnDefinition x:Name="ColSplit1" Width="6"/>
                    <ColumnDefinition x:Name="ColCenter" Width="*"/>
                    <ColumnDefinition x:Name="ColSplit2" Width="6"/>
                    <ColumnDefinition x:Name="ColRight"  Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧面板 -->
                <Border Grid.Column="0" Margin="0,4,0,0"
                        Visibility="{Binding PanelL.IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{StaticResource NoteBg}"
                        BorderBrush="{StaticResource NoteBorder}"
                        BorderThickness="1" CornerRadius="6"
                        MouseLeftButtonDown="Panel_Click" Tag="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveIndex}" Value="0">
                                    <Setter Property="BorderBrush" Value="{StaticResource NoteActiveBorder}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="2,0,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding PanelLabelL, FallbackValue='①'}" FontSize="10"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        <wv2:WebView2 Grid.Row="1" x:Name="EditorLeft"
                                      GotFocus="Editor_GotFocus" Tag="0"
                                      MouseLeftButtonDown="Panel_Click"/>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="6"
                              Background="Transparent"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" Cursor="SizeWE"/>

                <!-- 中间面板 -->
                <Border Grid.Column="2" Margin="0,4,0,0"
                        Visibility="{Binding PanelC.IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{StaticResource NoteBg}"
                        BorderBrush="{StaticResource NoteBorder}"
                        BorderThickness="1" CornerRadius="6"
                        MouseLeftButtonDown="Panel_Click" Tag="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveIndex}" Value="1">
                                    <Setter Property="BorderBrush" Value="{StaticResource NoteActiveBorder}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="2,0,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding PanelLabelC, FallbackValue='②'}" FontSize="10"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        <wv2:WebView2 Grid.Row="1" x:Name="EditorCenter"
                                      GotFocus="Editor_GotFocus" Tag="1"
                                      MouseLeftButtonDown="Panel_Click"/>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="3" Width="6"
                              Background="Transparent"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" Cursor="SizeWE"/>

                <!-- 右侧面板 -->
                <Border Grid.Column="4" Margin="0,4,0,0"
                        Visibility="{Binding PanelR.IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{StaticResource NoteBg}"
                        BorderBrush="{StaticResource NoteBorder}"
                        BorderThickness="1" CornerRadius="6"
                        MouseLeftButtonDown="Panel_Click" Tag="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveIndex}" Value="2">
                                    <Setter Property="BorderBrush" Value="{StaticResource NoteActiveBorder}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="2,0,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding PanelLabelR, FallbackValue='③'}" FontSize="10"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        <wv2:WebView2 Grid.Row="1" x:Name="EditorRight"
                                      GotFocus="Editor_GotFocus" Tag="2"
                                      MouseLeftButtonDown="Panel_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
