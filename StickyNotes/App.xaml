<Application x:Class="StickyNotes.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ═══ 全局共享颜色 ═══ -->
            <SolidColorBrush x:Key="BgDark" Color="#1A1B2E"/>
            <SolidColorBrush x:Key="BgTitleBar" Color="#1E1F35"/>
            <SolidColorBrush x:Key="BgPanel" Color="#252640"/>
            <SolidColorBrush x:Key="BgCard" Color="#2A2B45"/>
            <SolidColorBrush x:Key="CardBorder" Color="#3A3B60"/>
            <SolidColorBrush x:Key="AccentPurple" Color="#7C5CFC"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#E8E8F0"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#8888A0"/>
            <SolidColorBrush x:Key="TabActive" Color="#3A3B60"/>
            <SolidColorBrush x:Key="TabInactive" Color="#252640"/>
            <SolidColorBrush x:Key="NoteBg" Color="#F5F5F0"/>
            <SolidColorBrush x:Key="NoteBorder" Color="#E0E0D8"/>
            <SolidColorBrush x:Key="NoteActiveBorder" Color="#7C5CFC"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
